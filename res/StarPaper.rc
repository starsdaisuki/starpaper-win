#include <windows.h>

// 图标沿用 macOS 版那颗星（Resources/AppIcon.icns 转过来的）。
// ID 必须是最小的整数 —— Explorer 拿 exe 的图标时取的是 ID 最小的那个。
1 ICON "StarPaper.ico"

// CREATEPROCESS_MANIFEST_RESOURCE_ID = 1
1 24 "StarPaper.manifest"

// 版本资源。缺了它，exe 属性页的「详细信息」和「设置 → 应用」里的版本号全是空的
// （注册「设置 → 应用」条目时会暴露：DisplayVersion 读出来是空字符串）。
// 值由 Makefile 用 -D 传进来，改版本只改 Makefile 顶部的 VERSION 一处。
// ⚠️ 版本号不能带引号传进来：windres 把 -D 参数拼成命令行再交给 cpp，
// 中间多一次 shell 解析，`-DX='"1.0"'` 到 cpp 手上会变成裸的 1.0 → 语法错误。
// 所以传裸值 `-DSP_VER_STR=0.1.0`，引号在 rc 里用 stringize 补上。
#ifndef SP_VER_STR
#define SP_VER_STR 0.0.0
#endif
#ifndef SP_VER_NUM
#define SP_VER_NUM 0,0,0,0
#endif
#define SP_STR2(x) #x
#define SP_STR(x)  SP_STR2(x)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SP_VER_NUM
 PRODUCTVERSION SP_VER_NUM
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"                        // en-US, Unicode
    BEGIN
      VALUE "CompanyName",      "starsdaisuki"
      VALUE "FileDescription",  "StarPaper - live video wallpaper"
      VALUE "FileVersion",      SP_STR(SP_VER_STR)
      VALUE "InternalName",     "StarPaper"
      VALUE "LegalCopyright",   "Copyright (C) 2026 starsdaisuki. GPL-3.0-or-later."
      VALUE "OriginalFilename", "StarPaper.exe"
      VALUE "ProductName",      "StarPaper"
      VALUE "ProductVersion",   SP_STR(SP_VER_STR)
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
